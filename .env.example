# Firebase Console > Project settings > Your apps > Web app config.
# These identify the web app; do not put service account private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development uses the Vite proxy. Production uses the deployed Worker URL.
VITE_API_BASE_URL=

# GA4 measurement ID. Local and preview hosts never send analytics.
VITE_GA_MEASUREMENT_ID=
