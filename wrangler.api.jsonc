{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azuki-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "vars": {
    "FIREBASE_PROJECT_ID": "azuki-eed67",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://azuki-4ti.pages.dev,https://azuki.mame-app.com",
    "ALLOW_IMPORTS": "true",
    "EMAIL_ENABLED": "true",
    "EMAIL_DAILY_LIMIT": "290",
    "EMAIL_FROM": "support@volta.jp",
    "EMAIL_API_URL": "https://azuki-api.mizuno-taiyo-sub.workers.dev/api/email/unsubscribe",
    "ADMIN_EMAILS": "taiyo.mizuno.main@gmail.com",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azuki-db",
      "database_id": "781793ef-ad7d-474f-b7cf-87585e1b561a",
      "migrations_dir": "migrations",
    },
  ],
}
