{
  "name": "azuki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --port 8787",
    "db:local": "wrangler d1 migrations apply azuki-db --local --config wrangler.api.jsonc",
    "db:remote": "wrangler d1 migrations apply azuki-db --remote --config wrangler.api.jsonc",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name azuki --branch main",
    "content:build": "npm run content:dictionary && npm run content:official && npm run content:cefrj",
    "content:dictionary": "node scripts/build-dictionary.mjs",
    "content:cefrj": "node --experimental-strip-types scripts/build-cefrj.mjs",
    "content:official": "node --experimental-strip-types scripts/build-official-static.mjs",
    "pretest": "npm run content:build",
    "prebuild": "npm run content:build"
  },
  "dependencies": {
    "@toon-format/toon": "^4.4.0",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "description": "英単語帳を作って、学んで、共有できるWebアプリ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ta1yo1022/Azuki.git"
  },
  "bugs": {
    "url": "https://github.com/ta1yo1022/Azuki/issues"
  },
  "homepage": "https://azuki.mame-app.com",
  "engines": {
    "node": "^22.23.4"
  }
}
